  "patchedGrammarSHA256": "71731ca48b47dba3f9c9c72029106cf68be19d191c76cc9d423c2b9183c071a6",
  "replacements": [
    {
      "description": "register a distinct module-import declaration",
      "old": "      $.package_declaration,\n      $.import_declaration,",
      "new": "      $.package_declaration,\n      $.module_import_declaration,\n      $.import_declaration,"
    },
    {
      "description": "define the module-import production",
      "old": "    import_declaration: $ => seq(\n      'import',",
      "new": "    module_import_declaration: $ => seq(\n      'import',\n      'module',\n      field('module', $._name),\n      ';',\n    ),\n\n    import_declaration: $ => seq(\n      'import',"
    },
    {
      "description": "allow a statement prologue before explicit constructor invocation",
      "old": "      optional($.explicit_constructor_invocation),\n      repeat($.statement),",
      "new": "      choice(\n        seq(\n          optional($.explicit_constructor_invocation),\n          repeat($.statement),\n        ),\n        seq(\n          repeat1($.statement),\n          $.explicit_constructor_invocation,\n          repeat($.statement),\n        ),\n      ),"
    }
  ]
}
